# Copy this file to .env and fill in your values. Never commit .env: it holds your database password.
# On Render (day 6) these same names go in the service's Environment settings instead.

# Port the server listens on locally. Render sets its own.
PORT=3000

# "development" locally. Use "production" only on the host: it turns on secure cookies and https rules.
NODE_ENV=development

# The address people open in the browser. Locally leave it as is; on Render use the https://… URL.
APP_ORIGIN=http://localhost:3000

# Supabase dashboard → your project → Connect → Session pooler → URI.
# Replace [YOUR-PASSWORD] with the database password you set when creating the project.
# If the password has symbols such as @ # / ?, percent-encode them (for example @ becomes %40).
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Optional but recommended: lets the server verify it is talking to the real Supabase database.
# Download it from Supabase → Database → Settings → SSL Configuration → Download certificate,
# save it as certs/supabase-ca.crt, then uncomment the next line.
# DATABASE_CA_FILE=certs/supabase-ca.crt

# Sign-in. Supabase → Project Settings → API Keys. The URL is on Project Settings → Data API.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only: it can create and delete accounts. Never put it in a page, a chat or a commit.
SUPABASE_SECRET_KEY=sb_secret_...

# Password for every demo account that npm run seed creates (at least 8 characters).
# Use a different one on the demo project, and only share it with the people you demo to.
SEED_PASSWORD=
